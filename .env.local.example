# ─── AI models (ticket 01: no model id is ever hardcoded) ───
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ─── Database ───
DATABASE_PATH=./data/matura.sqlite

# ─── NextAuth v5 (ticket 02) ───
# AUTH_SECRET is the v5 name; NEXTAUTH_SECRET is still read as a fallback.
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Langfuse (ticket 12) — optional; tracing is skipped when unset ───
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# ─── Golden-set gate (ticket 09) — override only for tests ───
# GOLDEN_SET_RESULT_PATH=
